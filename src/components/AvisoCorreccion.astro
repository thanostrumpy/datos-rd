---
interface Props {
  fecha: Date | string;
  descripcion: string;
}

const { fecha, descripcion } = Astro.props;
const fechaFormateada = typeof fecha === 'string' 
  ? fecha 
  : fecha.toLocaleDateString('es-DO', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div class="aviso-correccion" role="note" aria-label="Nota de corrección o actualización">
  <div class="correccion-header">
    <span class="correccion-tag">Actualización / Corrección</span>
    <time class="correccion-fecha">{fechaFormateada}</time>
  </div>
  <p class="correccion-texto">{descripcion}</p>
</div>

<style>
  .aviso-correccion {
    border-left: 4px solid var(--color-primary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left-width: 4px;
    border-left-color: var(--color-primary);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
  }

  .correccion-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .correccion-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .correccion-fecha {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .correccion-texto {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text);
  }
</style>
