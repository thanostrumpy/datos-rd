---
import BaseLayout from './BaseLayout.astro';
import Fuentes from '../components/Fuentes.astro';
import AvisoDatosEjemplo from '../components/AvisoDatosEjemplo.astro';
import Newsletter from '../components/Newsletter.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  articulo: CollectionEntry<'articulos'>;
}

const { articulo } = Astro.props;
const {
  titulo,
  descripcion,
  fecha,
  actualizado,
  categoria,
  etiquetas = [],
  fuentes = [],
  estado,
  tipo,
} = articulo.data;

const fechaFormateada = fecha.toLocaleDateString('es-DO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const actualizadoFormateado = actualizado
  ? actualizado.toLocaleDateString('es-DO', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout
  title={titulo}
  description={descripcion}
  isArticle={true}
  articleDate={fecha}
  articleModified={actualizado || fecha}
>
  <article class="articulo-completo">
    <header class="articulo-cabecera">
      <div class="container prose-container">
        <!-- Migas de pan accesibles -->
        <nav class="migas-pan" aria-label="Ruta de navegación">
          <ol>
            <li><a href="/">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/articulos">Artículos</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={`/articulos?categoria=${categoria}`}>{categoria}</a></li>
          </ol>
        </nav>

        <div class="articulo-tags-superiores">
          <span class="badge">{categoria}</span>
          <span class="articulo-tipo-pill">{tipo}</span>
          {estado === 'borrador' && (
            <span class="badge badge-draft">Borrador no publicado</span>
          )}
        </div>

        <h1 class="articulo-h1">{titulo}</h1>
        <p class="articulo-bajada">{descripcion}</p>

        <div class="articulo-autoria-fechas">
          <div class="articulo-autor">
            <span class="autor-nombre">Equipo de Investigación Datos RD</span>
          </div>
          <div class="articulo-fechas">
            <time datetime={fecha.toISOString()}>Publicado: {fechaFormateada}</time>
            {actualizadoFormateado && (
              <span class="fecha-actualizacion">
                • Actualizado: {actualizadoFormateado}
              </span>
            )}
          </div>
        </div>

        {/* Si el artículo está en estado de borrador o contiene datos de ejemplo */}
        <AvisoDatosEjemplo />
      </div>
    </header>

    <div class="container prose-container">
      <!-- Slot adicional para el gráfico destacado o métricas principales si se pasan como children -->
      <slot name="grafico-destacado" />

      <!-- Cuerpo Markdown del artículo -->
      <div class="article-body">
        <slot />
      </div>

      <!-- Bloque de Fuentes y Metodología obligatoria (Regla AGENTS.md) -->
      <Fuentes fuentes={fuentes} />

      <!-- Etiquetas del artículo -->
      {etiquetas.length > 0 && (
        <div class="articulo-etiquetas-finales">
          <span class="etiquetas-label">Temas relacionados:</span>
          <ul class="etiquetas-lista">
            {etiquetas.map((t) => (
              <li class="etiqueta-item">#{t}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Bloque de Newsletter al final de cada artículo -->
      <Newsletter />
    </div>
  </article>
</BaseLayout>

<style>
  .articulo-cabecera {
    padding: 2.5rem 0 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
    background-color: var(--color-surface);
  }

  .migas-pan ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .migas-pan a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .migas-pan a:hover {
    color: var(--color-primary);
  }

  .articulo-tags-superiores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .articulo-tipo-pill {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
  }

  .articulo-h1 {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 640px) {
    .articulo-h1 {
      font-size: 1.75rem;
    }
  }

  .articulo-bajada {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .articulo-autoria-fechas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .autor-nombre {
    font-weight: 600;
    color: var(--color-text);
  }

  .articulo-etiquetas-finales {
    margin: 2.5rem 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .etiquetas-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .etiquetas-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .etiqueta-item {
    background-color: var(--color-surface-hover);
    color: var(--color-text-muted);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }
</style>
