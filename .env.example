# Variables de entorno opcionales para Datos RD
# Copia este archivo a .env para personalizar valores locales

# URL pública del sitio (usada para la generación de enlaces canónicos y sitemap)
SITE_URL=https://datosrd.com

# URL del formulario de suscripción al newsletter (Substack, Beehiiv, Mailchimp, etc.)
PUBLIC_NEWSLETTER_URL=https://datosrd.substack.com/subscribe

# Correo de contacto y recepción de reportes de correcciones
PUBLIC_CONTACT_EMAIL=contacto@datosrd.com
