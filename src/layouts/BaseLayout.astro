---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  articleDate?: Date;
  articleModified?: Date;
  articleAuthor?: string;
}

const {
  title,
  description,
  image,
  isArticle = false,
  articleDate,
  articleModified,
  articleAuthor,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      isArticle={isArticle}
      articleDate={articleDate}
      articleModified={articleModified}
      articleAuthor={articleAuthor}
    />
  </head>
  <body>
    <a href="#contenido-principal" class="saltar-contenido">
      Saltar al contenido principal
    </a>

    <Header />

    <main id="contenido-principal" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <style>
      .saltar-contenido {
        position: absolute;
        top: -40px;
        left: 0;
        background: var(--color-primary);
        color: #ffffff;
        padding: 0.5rem 1rem;
        z-index: 100;
        text-decoration: none;
        font-weight: 600;
        border-radius: 0 0 var(--radius-sm) 0;
        transition: top 0.2s ease;
      }

      .saltar-contenido:focus {
        top: 0;
      }

      #contenido-principal {
        flex: 1;
        outline: none;
      }
    </style>
  </body>
</html>
