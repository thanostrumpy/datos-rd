---
interface Fuente {
  nombre: string;
  url: string;
  fecha_consulta: Date | string;
}

interface Props {
  fuentes: Fuente[];
  metodologiaTexto?: string;
}

const { fuentes = [], metodologiaTexto } = Astro.props;

function formatFecha(f: Date | string) {
  const d = typeof f === 'string' ? new Date(f) : f;
  return d.toLocaleDateString('es-DO', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<div class="bloque-fuentes" id="fuentes-y-metodologia">
  <div class="fuentes-encabezado">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
    <h3 class="fuentes-titulo">Fuentes y verificación de datos</h3>
  </div>

  <p class="fuentes-descripcion">
    En cumplimiento con las normas editoriales de <strong>Datos RD</strong>, cada cifra utilizada cuenta con atribución verificable a fuentes públicas y oficiales:
  </p>

  <ul class="fuentes-lista">
    {fuentes.map((item) => (
      <li class="fuente-item">
        <span class="fuente-nombre">
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            {item.nombre}
          </a>
        </span>
        <span class="fuente-fecha">
          (Fecha de consulta: {formatFecha(item.fecha_consulta)})
        </span>
      </li>
    ))}
  </ul>

  {metodologiaTexto && (
    <div class="fuentes-metodologia">
      <h4>Nota metodológica</h4>
      <p>{metodologiaTexto}</p>
    </div>
  )}
</div>

<style>
  .bloque-fuentes {
    margin-top: 3rem;
    padding: 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .fuentes-encabezado {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .fuentes-titulo {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .fuentes-descripcion {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .fuentes-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fuente-item {
    font-size: 0.9375rem;
    padding-left: 1.25rem;
    position: relative;
  }

  .fuente-item::before {
    content: "•";
    position: absolute;
    left: 0.25rem;
    color: var(--color-accent);
    font-weight: bold;
  }

  .fuente-nombre a {
    font-weight: 600;
  }

  .fuente-fecha {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-left: 0.35rem;
  }

  .fuentes-metodologia {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .fuentes-metodologia h4 {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }
</style>
