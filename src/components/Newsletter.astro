---
import { SITE_CONFIG } from '../config/site';

interface Props {
  titulo?: string;
  descripcion?: string;
  actionUrl?: string; // Configurable para Beehiiv, Substack, Formspree o servicio gratuito
}

const {
  titulo = "Entiende los números que mueven a República Dominicana",
  descripcion = "Recibe en tu correo un análisis semanal con gráficos originales, contexto económico y datos verificados. Sin spam ni titulares sensacionalistas.",
  actionUrl = SITE_CONFIG.newsletterUrl,
} = Astro.props;
---

<section class="newsletter-seccion" aria-labelledby="newsletter-titulo">
  <div class="newsletter-caja">
    <div class="newsletter-info">
      <span class="newsletter-kicker">Boletín gratuito</span>
      <h2 id="newsletter-titulo" class="newsletter-titulo">{titulo}</h2>
      <p class="newsletter-texto">{descripcion}</p>
    </div>

    <form
      action={actionUrl}
      method="post"
      target="_blank"
      rel="noopener noreferrer"
      class="newsletter-formulario"
      aria-label="Formulario de suscripción al newsletter"
    >
      <div class="formulario-grupo">
        <label for="newsletter-email" class="visually-hidden">Correo electrónico</label>
        <input
          type="email"
          id="newsletter-email"
          name="email"
          placeholder="tu.correo@ejemplo.com"
          required
          class="newsletter-input"
          autocomplete="email"
        />
        <button type="submit" class="btn btn-primary newsletter-btn">
          Suscribirme
        </button>
      </div>
      <p class="newsletter-privacidad">
        Respetamos tu privacidad. Puedes darte de baja con un clic en cualquier momento.
      </p>
    </form>
  </div>
</section>

<style>
  .newsletter-seccion {
    margin: 3.5rem 0;
  }

  .newsletter-caja {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow-sm);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .newsletter-caja::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, #002f6c 0%, #0284c7 50%, #ce1126 100%);
  }

  @media (max-width: 768px) {
    .newsletter-caja {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.25rem;
      gap: 1.5rem;
    }
  }

  .newsletter-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .newsletter-titulo {
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .newsletter-texto {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .formulario-grupo {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 480px) {
    .formulario-grupo {
      flex-direction: column;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .newsletter-input {
    flex: 1;
    padding: 0.65rem 1rem;
    font-size: 0.9375rem;
    font-family: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: border-color 0.15s;
  }

  .newsletter-input:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .newsletter-btn {
    white-space: nowrap;
  }

  .newsletter-privacidad {
    font-size: 0.775rem;
    color: var(--color-text-light);
    margin-top: 0.65rem;
    line-height: 1.4;
  }
</style>
